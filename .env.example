# --- База данных (Supabase Postgres) ---
# Пул соединений (pgbouncer, порт 6543) — используется приложением в runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Прямое подключение (порт 5432) — используется Prisma Migrate / Studio
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# --- Сессии (собственный слой, замена Supabase Auth) ---
# Секрет подписи session-cookie. Обязателен. Сгенерировать: openssl rand -hex 32
SESSION_SECRET="<hex-32-bytes>"

# --- Storage: Cloudflare R2 (S3-совместимый, нулевой egress) ---
STORAGE_DRIVER="r2"                     # r2 | supabase
R2_ACCOUNT_ID="<account-id>"
R2_BUCKET="forzadj"                     # один бакет, логические — под префиксами
R2_ACCESS_KEY_ID="<access-key-id>"
R2_SECRET_ACCESS_KEY="<secret-access-key>"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# --- Supabase (ЛЕГАСИ: Auth и Storage больше НЕ используются) ---
# Оставлено для возможного отката storage на supabase (STORAGE_DRIVER=supabase).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# --- Storage: приватные бакеты ---
STORAGE_BUCKET_AUDIO="audio"          # оригиналы и транскоды
STORAGE_BUCKET_PREVIEWS="previews"    # превью для стриминга
STORAGE_BUCKET_ARTWORK="artwork"      # обложки
STORAGE_BUCKET_RECEIPTS="receipts"    # чеки к заявкам поддержки (приватный)
STORAGE_BUCKET_SUBMISSIONS="submissions" # аудио пользовательских заявок (приватный)
STORAGE_BUCKET_SUPPORT="support"      # вложения обращений в поддержку (приватный)

# --- Telegram Admin Bot (внутренний API для загрузки треков) ---
# Общий секрет с forzadj-admin-bot. Любая строка, минимум 32 символа.
BOT_UPLOAD_SECRET="<strong-random-secret>"

# --- Telegram Login (Этап 1) ---
TELEGRAM_BOT_TOKEN="<bot-token>"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="<bot-username>"
# Telegram ID владельца проекта — получает роль SUPER_ADMIN при входе.
# Именно числовой ID, не username.
FORZADJ_OWNER_TELEGRAM_ID="727850088"

# --- Пользовательские заявки на публикацию (бот модерации) ---
# HTTP-ingest бота модерации (@forzadj_creator_bot) на VPS, localhost.
MODERATION_INGEST_URL="http://127.0.0.1:8790"
MODERATION_INGEST_SECRET="<strong-random-secret>"   # совпадает с ботом модерации
# Секрет колбэка статуса модерации (сайт ← бот модерации): /api/submissions/[id]/moderate
MODERATION_API_SECRET="<strong-random-secret>"      # совпадает с ботом модерации

# --- Обращения в поддержку (бот поддержки) ---
# Токен @forza_sup_bot: сайт напрямую доставляет тикеты в Telegram.
SUPPORT_BOT_TOKEN="<support-bot-token>"
SUPPORT_ADMIN_CHAT_ID="727850088"                   # чат администратора для тикетов

# --- Приложение ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Лимиты скачиваний (донат-модель, без подписок) ---
# Все значения опциональны; при отсутствии берутся дефолты из кода.
DOWNLOAD_DAILY_LIMIT="75"          # скачиваний в сутки на пользователя
DOWNLOAD_MAX_PER_TRACK="2"         # макс. скачиваний одного трека одним юзером
DOWNLOAD_RATE_MAX="20"             # rate limit: макс. запросов в окне
DOWNLOAD_RATE_WINDOW_MS="60000"    # rate limit: длина окна, мс

# --- Реквизиты доната (личные банковские данные — не для публичного репо!) ---
# Показываются в модалке "Поддержать". Все значения — публично видимый текст
# в UI, но храним их в env, а не в исходном коде.
NEXT_PUBLIC_DONATE_RU_BANK="<bank-name>"
NEXT_PUBLIC_DONATE_RU_CARD="<card-number>"
NEXT_PUBLIC_DONATE_RU_SBP_PHONE="<phone-number>"
NEXT_PUBLIC_DONATE_INTL_BANK="<bank-name>"
NEXT_PUBLIC_DONATE_INTL_CARD="<card-number>"
NEXT_PUBLIC_DONATE_SWIFT_RECIPIENT="<full-name>"
NEXT_PUBLIC_DONATE_SWIFT_BANK="<bank-name-and-address>"
NEXT_PUBLIC_DONATE_SWIFT_BRANCH="<branch-code>"
NEXT_PUBLIC_DONATE_SWIFT_CURRENCY="USD"
NEXT_PUBLIC_DONATE_SWIFT_INN="<tax-id>"
NEXT_PUBLIC_DONATE_SWIFT_CODE="<swift-code>"
NEXT_PUBLIC_DONATE_SWIFT_IBAN="<iban>"
NEXT_PUBLIC_DONATE_SWIFT_CORR_BANK="<correspondent-bank-name>"
NEXT_PUBLIC_DONATE_SWIFT_CORR_CODE="<correspondent-swift-code>"
NEXT_PUBLIC_DONATE_SWIFT_CORR_ACCOUNT="<correspondent-account-number>"
