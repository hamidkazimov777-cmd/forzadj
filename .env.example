# --- База данных (Supabase Postgres) ---
# Пул соединений (pgbouncer, порт 6543) — используется приложением в runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Прямое подключение (порт 5432) — используется Prisma Migrate / Studio
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# --- Supabase (Auth v1 + Storage за адаптером) ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# Только сервер. Никогда не префиксовать NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# --- Storage: приватные бакеты ---
STORAGE_BUCKET_AUDIO="audio"          # оригиналы и транскоды
STORAGE_BUCKET_PREVIEWS="previews"    # превью для стриминга
STORAGE_BUCKET_ARTWORK="artwork"      # обложки

# --- Telegram Login (Этап 1) ---
TELEGRAM_BOT_TOKEN="<bot-token>"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="<bot-username>"

# --- Приложение ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
