// Схема БД ForzaDJ Pool.
// Этап 0: минимальный скелет, доказывающий работу soft-delete-механики.
// Полная модель Identity (Этап 1) и контента Release→Track→Version→Asset (Этап 2)
// добавляются соответствующими этапами.
//
// Соглашения:
// - id: UUID v7 (сортируемые, безопасны для публичных URL)
// - все таблицы: createdAt / updatedAt
// - soft delete: deletedAt / deletedById; частичные уникальные индексы
//   (WHERE deleted_at IS NULL) добавляются raw-SQL в миграциях,
//   т.к. Prisma не поддерживает их декларативно.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DJ
  UPLOADER
  ADMIN
}

enum AuthProvider {
  TELEGRAM
  EMAIL
}

model User {
  id             String    @id @default(uuid(7)) @db.Uuid
  /// Ссылка на auth.users Supabase Auth (v1). При смене провайдера auth
  /// связь переезжает в auth_identities без изменения этой таблицы.
  supabaseUserId String    @unique @map("supabase_user_id") @db.Uuid
  displayName    String    @map("display_name")
  avatarUrl      String?   @map("avatar_url")
  role           UserRole  @default(DJ)
  bannedAt       DateTime? @map("banned_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id") @db.Uuid

  identities AuthIdentity[]

  @@map("users")
}

/// Способ входа, отделённый от пользователя. v1: TELEGRAM (через Supabase
/// Auth с синтетическим email). Новый провайдер = новая запись, users
/// не меняется — гарантия замены auth-провайдера без миграции.
model AuthIdentity {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id])
  provider       AuthProvider
  /// telegram: числовой id пользователя Telegram (строкой); email: адрес.
  providerUserId String       @map("provider_user_id")
  /// Снимок профиля провайдера (username, photo_url и т.п.).
  profile        Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}
